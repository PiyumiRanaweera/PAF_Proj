# Smart Campus API - Environment Variables
# Copy this file to .env and fill in your values
# NEVER commit the actual .env file to GitHub

# Supabase PostgreSQL Connection
SUPABASE_HOST=db.YOUR_PROJECT_REF.supabase.co
SUPABASE_PASSWORD=YOUR_SUPABASE_DB_PASSWORD

# Google OAuth2 Credentials
# Get these from https://console.cloud.google.com/
GOOGLE_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID
GOOGLE_CLIENT_SECRET=YOUR_GOOGLE_CLIENT_SECRET

# JWT Secret (must be at least 256 bits / 32 characters)
JWT_SECRET=SmartCampus2026SuperSecretKeyForJWTMustBe256BitsLong
